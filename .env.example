# Instagram Credentials (Option A: Username & Password, Option B: Session ID from browser)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
# INSTAGRAM_SESSIONID=your_sessionid_cookie_value (Recommended if login is challenged or 2FA is active)
HASHTAGS=indianarmy,indianarmedforces
OLLAMA_MODEL=llama3.2
OFFICIAL_INFORMATION_SOURCE=https://your-approved-official-source.example

# Automation and pacing settings
MAX_COMMENTS_PER_SESSION=3
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=180
FOLLOWER_THRESHOLD=0
FOLLOW_BUSINESSES=True
SCHEDULE_MODE=False
